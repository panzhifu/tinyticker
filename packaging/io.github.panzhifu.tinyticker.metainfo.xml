<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.panzhifu.tinyticker</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>TinyTicker</name>
  <summary>Minimal floating countdown, stopwatch, pomodoro and clock widget</summary>
  <developer id="io.github.panzhifu">
    <name>panzhifu</name>
  </developer>

  <description>
    <p>
      TinyTicker 是用纯 CPU 软渲染的极简悬浮计时器，内置 8x8 位图字体，
      单二进制 0.5 MB 且零第三方依赖，无任何运行时字体或 UI 依赖。
      无边框透明悬浮窗，逐像素预乘 ARGB。
    </p>
    <p>TinyTicker 提供四种模式：倒计时、秒表、番茄钟（专注/休息自动轮转）、时钟挂件（12/24 小时制）。</p>
    <ul>
      <li>Wayland 上走 layer-shell 的 overlay 层，网页视频全屏时依然可见</li>
      <li>左键拖动、右键关闭、滚轮缩放；托盘左键开始/暂停、中键重置、右键完整菜单</li>
      <li>托盘图标每秒重绘：真实时表盘，或 CPU / 内存 / 电量的占用水位表</li>
      <li>托盘「外观」子菜单即时调背景透明度与配色预设，在图标上滚动即可缩放</li>
      <li>时长支持相对写法 25m / 1h30m，也支持绝对时刻 14:30</li>
      <li>计时结束发桌面通知，并可执行自定义命令（锁屏、关机等）</li>
      <li>走时以整数秒为基准，休眠恢复或高负载后自动补齐，不漂移</li>
    </ul>
  </description>

  <categories>
    <category>Utility</category>
    <category>Clock</category>
  </categories>
  <keywords>
    <keyword>countdown</keyword>
    <keyword>timer</keyword>
